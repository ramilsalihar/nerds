# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/nerds_showcase?schema=public"

JWT_SECRET="change-me-in-production"
PORT=3000

# Cloudinary (project image uploads). Copy "API environment variable" from the Cloudinary dashboard.
# Leave unset to disable uploads (pasting image URLs still works).
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
